# AppArmor profile for rerouted-egress, which makes rerouted's connections out
# (internal/egress). Install as /etc/apparmor.d/rerouted-egress, next to the rerouted
# profile:
#
#   sudo install -m 644 deploy/apparmor/rerouted-egress /etc/apparmor.d/rerouted-egress
#   sudo apparmor_parser -r -W /etc/apparmor.d/rerouted-egress

abi <abi/3.0>,

include <tunables/global>

@{rerouted_conf}=/etc/rerouted

# attach_disconnected: in the unit's mount namespace, a path like its socket can't be named
# from the host's root without it.
profile rerouted-egress /usr/local/bin/rerouted-egress flags=(enforce, attach_disconnected) {
  include <abstractions/base>

  deny capability,

  # TCP out, DNS, rerouted's socket and the journal's.
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network unix stream,
  deny network netlink,
  deny network packet,
  deny network inet raw,
  deny network inet6 raw,
  /{run,var/run}/rerouted-egress/egress.sock rw,

  # Go's own resolver: no NSS modules, only these.
  /etc/hosts r,
  /etc/host.conf r,
  /etc/nsswitch.conf r,
  /etc/resolv.conf r,
  /{run,var/run}/systemd/resolve/{stub-,}resolv.conf r,
  /{run,var/run}/NetworkManager/{no-stub-,}resolv.conf r,
  /{run,var/run}/resolvconf/resolv.conf r,

  /usr/local/bin/rerouted-egress mr,
  /usr/share/zoneinfo/** r,
  /etc/localtime r,
  # -allow-user: the user's ID.
  /etc/passwd r,

  # The Go runtime.
  /sys/kernel/mm/transparent_hugepage/hpage_pmd_size r,
  @{PROC}/sys/net/core/somaxconn r,
  @{PROC}/@{pid}/cgroup r,
  @{PROC}/@{pid}/mountinfo r,
  @{PROC}/@{pid}/stat r,
  /sys/fs/cgroup/{,**/}cpu.max r,
  /sys/fs/cgroup/{,**/}cpu.cfs_{quota,period}_us r,
  /sys/devices/system/cpu/online r,

  # rerouted's settings (REROUTED_FED_ALLOW and REROUTED_TLS_ASK_ALSO), which systemd
  # hands over; run by hand, with -env, the file.
  /{run,var/run}/credentials/rerouted-egress.service/ r,
  /{run,var/run}/credentials/rerouted-egress.service/rerouted.env r,
  @{rerouted_conf}/ r,
  @{rerouted_conf}/** r,

  signal (receive) set=(term, int, kill, hup) peer=unconfined,
  signal (send, receive) peer=rerouted-egress,

  deny /var/lib/rerouted{,-*}/** rwklmx,
  deny /{usr/,}{s,}bin/** x,
  deny ptrace,
  deny mount,
  deny umount,
  deny pivot_root,
  deny @{PROC}/sys/** w,
  deny /sys/** w,

  include if exists <local/rerouted-egress>
}
