policy_module(rerouted, 1.0.0)

########################################
#
# Declarations
#
# rerouted runs in rerouted_t when systemd starts /usr/local/bin/rerouted. Operator
# commands run from a shell stay in the caller's domain (sudo -u rerouted rerouted ...):
# use runcon or systemd-run to give them the same confinement.

## <desc>
## <p>
## Allow rerouted to connect to any TCP port, not only HTTPS (443) and the local
## HTTP ports. Needed for dev mode peers (REROUTED_DEV_PEERS) on other ports, and for
## REROUTED_TLS_ASK_ALSO instances on ports outside http_port_t and http_cache_port_t.
## </p>
## </desc>
gen_tunable(rerouted_connect_any, false)

## <desc>
## <p>
## Allow rerouted to bind any unreserved UDP port: REROUTED_VOICE_UDP_PORT set to a
## port that has no label of its own. Ephemeral ports (the default, 0) need no boolean.
## </p>
## </desc>
gen_tunable(rerouted_bind_voice_port, true)

type rerouted_t;
type rerouted_exec_t;
init_daemon_domain(rerouted_t, rerouted_exec_t)
# The unit sets NoNewPrivileges=yes, which blocks the transition from init_t unless the
# policy allows it: without this, rerouted would stay in init_t.
init_nnp_daemon_domain(rerouted_t)

# /etc/rerouted: the settings file, with secrets in it. Read only.
type rerouted_conf_t;
files_config_file(rerouted_conf_t)

# /var/lib/rerouted: server keys, database, files.
type rerouted_var_lib_t;
files_type(rerouted_var_lib_t)

# REROUTED_STORE=temp: a throwaway database under /tmp.
type rerouted_tmp_t;
files_tmp_file(rerouted_tmp_t)

# REROUTED_LISTEN. 8080, the default, is already http_cache_port_t: see below.
type rerouted_port_t;
corenet_port(rerouted_port_t)

# rerouted-keyd, which holds the server keys and signs for rerouted (REROUTED_KEYD).
type rerouted_keyd_t;
type rerouted_keyd_exec_t;
init_daemon_domain(rerouted_keyd_t, rerouted_keyd_exec_t)
init_nnp_daemon_domain(rerouted_keyd_t)

# /var/lib/rerouted-keyd: keys.cred, which systemd decrypts for rerouted-keyd, or key files.
type rerouted_keyd_var_lib_t;
files_type(rerouted_keyd_var_lib_t)

# /run/rerouted-keyd: the socket.
type rerouted_keyd_runtime_t;
files_pid_file(rerouted_keyd_runtime_t)

# rerouted-sfu, which runs voice channels' SFU for rerouted (REROUTED_SFU).
type rerouted_sfu_t;
type rerouted_sfu_exec_t;
init_daemon_domain(rerouted_sfu_t, rerouted_sfu_exec_t)
init_nnp_daemon_domain(rerouted_sfu_t)

# /run/rerouted-sfu: the socket.
type rerouted_sfu_runtime_t;
files_pid_file(rerouted_sfu_runtime_t)

########################################
#
# rerouted local policy
#

# No capabilities: it listens above 1024 and never changes user.
dontaudit rerouted_t self:capability { dac_override dac_read_search };
allow rerouted_t self:process { getsched signal sigchld sigkill sigstop signull };
allow rerouted_t self:fifo_file rw_fifo_file_perms;
allow rerouted_t self:unix_stream_socket create_stream_socket_perms;
allow rerouted_t self:tcp_socket { create_stream_socket_perms listen accept };
allow rerouted_t self:udp_socket create_socket_perms;
# net.Interfaces, which the voice SFU uses to find its addresses.
allow rerouted_t self:netlink_route_socket r_netlink_socket_perms;

# Settings
read_files_pattern(rerouted_t, rerouted_conf_t, rerouted_conf_t)
list_dirs_pattern(rerouted_t, rerouted_conf_t, rerouted_conf_t)
files_search_etc(rerouted_t)

# Data: keys, database (with -wal and -shm, which SQLite maps and locks), media files.
manage_dirs_pattern(rerouted_t, rerouted_var_lib_t, rerouted_var_lib_t)
manage_files_pattern(rerouted_t, rerouted_var_lib_t, rerouted_var_lib_t)
allow rerouted_t rerouted_var_lib_t:file { map lock };
files_var_lib_filetrans(rerouted_t, rerouted_var_lib_t, dir)
files_search_var_lib(rerouted_t)

# Temporary store
manage_dirs_pattern(rerouted_t, rerouted_tmp_t, rerouted_tmp_t)
manage_files_pattern(rerouted_t, rerouted_tmp_t, rerouted_tmp_t)
allow rerouted_t rerouted_tmp_t:file { map lock };
files_tmp_filetrans(rerouted_t, rerouted_tmp_t, { dir file })

# Its own binary.
allow rerouted_t rerouted_exec_t:file { map read execute entrypoint };

# The Go runtime: CPU count, cgroup CPU limit (GOMAXPROCS), huge page size, somaxconn.
kernel_read_system_state(rerouted_t)
kernel_read_net_sysctls(rerouted_t)
kernel_read_kernel_sysctls(rerouted_t)
dev_read_sysfs(rerouted_t)
fs_getattr_all_fs(rerouted_t)
fs_search_cgroup_dirs(rerouted_t)
fs_read_cgroup_files(rerouted_t)
dev_read_urand(rerouted_t)
dev_read_rand(rerouted_t)

# Listening: REROUTED_LISTEN, and the dev mode community listeners.
corenet_tcp_bind_generic_node(rerouted_t)
corenet_tcp_bind_http_cache_port(rerouted_t)
allow rerouted_t rerouted_port_t:tcp_socket name_bind;

# Voice: UDP on ephemeral ports, or REROUTED_VOICE_UDP_PORT.
corenet_udp_bind_generic_node(rerouted_t)
corenet_udp_bind_all_ephemeral_ports(rerouted_t)
allow rerouted_t rerouted_port_t:udp_socket name_bind;
tunable_policy(`rerouted_bind_voice_port',`
	corenet_udp_bind_all_unreserved_ports(rerouted_t)
')

# Federation: HTTPS to other servers. TLS ask: other instances on this host.
corenet_tcp_connect_http_port(rerouted_t)
corenet_tcp_connect_http_cache_port(rerouted_t)
allow rerouted_t rerouted_port_t:tcp_socket name_connect;
tunable_policy(`rerouted_connect_any',`
	corenet_tcp_connect_all_ports(rerouted_t)
')

# DNS, CA roots, time zones.
sysnet_dns_name_resolve(rerouted_t)
miscfiles_read_generic_certs(rerouted_t)
miscfiles_read_localization(rerouted_t)

# Logs go to stderr, which systemd connects to the journal.
logging_send_syslog_msg(rerouted_t)
init_use_fds(rerouted_t)

# REROUTED_KEYD: signatures from rerouted-keyd, over its socket.
files_search_pids(rerouted_t)
allow rerouted_t rerouted_keyd_runtime_t:dir search_dir_perms;
allow rerouted_t rerouted_keyd_runtime_t:sock_file write_sock_file_perms;
allow rerouted_t rerouted_keyd_t:unix_stream_socket connectto;

# REROUTED_SFU: rerouted-sfu, over its socket.
allow rerouted_t rerouted_sfu_runtime_t:dir search_dir_perms;
allow rerouted_t rerouted_sfu_runtime_t:sock_file write_sock_file_perms;
allow rerouted_t rerouted_sfu_t:unix_stream_socket connectto;

########################################
#
# rerouted-keyd local policy: no network, nothing to write but its own key files.
#

allow rerouted_keyd_t self:process { getsched signal sigchld sigkill sigstop signull };
allow rerouted_keyd_t self:fifo_file rw_fifo_file_perms;
allow rerouted_keyd_t self:unix_stream_socket { create_stream_socket_perms listen accept };
allow rerouted_keyd_t rerouted_keyd_exec_t:file { map read execute entrypoint };

# rerouted's settings: REROUTED_NAME and REROUTED_COMMUNITIES.
read_files_pattern(rerouted_keyd_t, rerouted_conf_t, rerouted_conf_t)
list_dirs_pattern(rerouted_keyd_t, rerouted_conf_t, rerouted_conf_t)
files_search_etc(rerouted_keyd_t)
# -allow-user: the user's ID.
auth_read_passwd(rerouted_keyd_t)

# keys.cred: systemd decrypts it for rerouted-keyd (LoadCredentialEncrypted), which
# never reads it itself.
gen_require(`
	type init_t, init_var_run_t;
')
allow init_t rerouted_keyd_var_lib_t:dir list_dir_perms;
allow init_t rerouted_keyd_var_lib_t:file read_file_perms;
# The decrypted keys, in /run/credentials/rerouted-keyd.service, which systemd labels
# init_var_run_t.
files_search_pids(rerouted_keyd_t)
allow rerouted_keyd_t init_var_run_t:dir list_dir_perms;
allow rerouted_keyd_t init_var_run_t:file read_file_perms;

# Without systemd-creds: key files.
manage_dirs_pattern(rerouted_keyd_t, rerouted_keyd_var_lib_t, rerouted_keyd_var_lib_t)
manage_files_pattern(rerouted_keyd_t, rerouted_keyd_var_lib_t, rerouted_keyd_var_lib_t)
files_search_var_lib(rerouted_keyd_t)

# The Go runtime.
kernel_read_system_state(rerouted_keyd_t)
kernel_read_kernel_sysctls(rerouted_keyd_t)
kernel_read_net_sysctls(rerouted_keyd_t)
dev_read_sysfs(rerouted_keyd_t)
fs_getattr_all_fs(rerouted_keyd_t)
fs_search_cgroup_dirs(rerouted_keyd_t)
fs_read_cgroup_files(rerouted_keyd_t)
dev_read_urand(rerouted_keyd_t)
dev_read_rand(rerouted_keyd_t)
miscfiles_read_localization(rerouted_keyd_t)

logging_send_syslog_msg(rerouted_keyd_t)
init_use_fds(rerouted_keyd_t)

########################################
#
# rerouted-sfu local policy: UDP and netlink, rerouted's socket, and nothing to read or
# write of its own.
#

allow rerouted_sfu_t self:process { getsched signal sigchld sigkill sigstop signull };
allow rerouted_sfu_t self:fifo_file rw_fifo_file_perms;
allow rerouted_sfu_t self:unix_stream_socket { create_stream_socket_perms listen accept };
allow rerouted_sfu_t self:udp_socket create_socket_perms;
allow rerouted_sfu_t self:netlink_route_socket r_netlink_socket_perms;
allow rerouted_sfu_t rerouted_sfu_exec_t:file { map read execute entrypoint };

# Media: UDP on ephemeral ports, or REROUTED_VOICE_UDP_PORT.
corenet_udp_bind_generic_node(rerouted_sfu_t)
corenet_udp_bind_all_ephemeral_ports(rerouted_sfu_t)
allow rerouted_sfu_t rerouted_port_t:udp_socket name_bind;
tunable_policy(`rerouted_bind_voice_port',`
	corenet_udp_bind_all_unreserved_ports(rerouted_sfu_t)
')

# -allow-user: the user's ID.
auth_read_passwd(rerouted_sfu_t)

# The Go runtime.
kernel_read_system_state(rerouted_sfu_t)
kernel_read_kernel_sysctls(rerouted_sfu_t)
kernel_read_net_sysctls(rerouted_sfu_t)
dev_read_sysfs(rerouted_sfu_t)
fs_getattr_all_fs(rerouted_sfu_t)
fs_search_cgroup_dirs(rerouted_sfu_t)
fs_read_cgroup_files(rerouted_sfu_t)
dev_read_urand(rerouted_sfu_t)
dev_read_rand(rerouted_sfu_t)
miscfiles_read_localization(rerouted_sfu_t)

logging_send_syslog_msg(rerouted_sfu_t)
init_use_fds(rerouted_sfu_t)
