# The socket rerouted connects out through. Only rerouted's group may connect, and
# rerouted-egress checks that the other end is rerouted's user too. Install with
# rerouted-egress.service, rerouted.socket, and rerouted.service.d/egress.conf
# (deploy/README.md).
[Unit]
Description=rerouted-egress socket

[Socket]
ListenStream=/run/rerouted-egress/egress.sock
SocketUser=rerouted-egress
SocketGroup=rerouted
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=true

[Install]
WantedBy=sockets.target
