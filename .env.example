# rerouted settings. Copy to .env and edit. Real environment variables override this file.

# This server's DNS name. Never an IP address (SPEC §5.1).
REROUTED_NAME=chat.example

# Address to listen on. Put TLS (port 443) in front with a reverse proxy for now.
REROUTED_LISTEN=127.0.0.1:8080

# Where the server key and data live.
REROUTED_DATA_DIR=./data

# Where clients and other servers reach the APIs. The server document publishes
# {PUBLIC_URL}{API_PATH}client/ and .../s2s/, and everyone finds them there (SPEC §8.1).
# REROUTED_PUBLIC_URL=https://chat.example
# REROUTED_API_PATH=/.well-known/tieroute/v1/
# Wire version 2's APIs, published beside version 1's while users migrate (SPEC §5.1).
# REROUTED_API_PATH_V2=/.well-known/tieroute/v2/

# Networks other servers may be reached at although they aren't on the public internet:
# addresses or CIDR prefixes, comma-separated. Outside dev mode, connections to loopback,
# link-local, private, and other non-global addresses are refused otherwise.
# REROUTED_FED_ALLOW=

# Domain to give out free subdomain handles under (kat.chat.example). Needs wildcard DNS and TLS.
REROUTED_HANDLES=chat.example

# invite or closed (SPEC §8.2). No email is ever asked for.
REROUTED_REGISTRATION=closed
# The registration invite code, at least 10 characters.
# REROUTED_REGISTRATION_CODE=
# on: publish the code in the server document, so anyone can sign up. Revoke by changing it.
# REROUTED_REGISTRATION_PUBLIC=off

# Storage: sqlite (default, in REROUTED_DATA_DIR/rerouted-v1.db, files in media/ beside it)
# or temp (a throwaway database, deleted on shutdown; for demos).
REROUTED_STORE=sqlite

# Bytes each identity may store in files (SPEC §14) and in backups (SPEC §7.5).
# A number of bytes, or with a K, M, or G suffix. Default 1G each.
# REROUTED_MEDIA_QUOTA=1G
# REROUTED_BACKUP_QUOTA=1G

# Call relay (SPEC §15.1): a TURN server such as coturn, with use-auth-secret and the same
# static-auth-secret here. Without these, GET turn answers 501 and calls can't be relayed.
# REROUTED_TURN_URLS=turn:turn.chat.example:3478,turns:turn.chat.example:5349
# REROUTED_TURN_SECRET=

# on: serve a public, unauthenticated feed of every delivery stored here, at GET /v0/dev/firehose
# (see README.md). Contents are never shown, but anyone can see who sends to whom, and when.
# Off by default. Only for a public development server whose users have agreed to it.
# REROUTED_PUBLIC_FIREHOSE=off

# on: refuse device-signed moves to and from this server (SPEC §6.6). Recovery-signed
# entries still go through. Off by default.
# REROUTED_PAUSE_MOVES=off

# Community servers (SPEC §16): server names this process serves as community servers, each
# hosting one community. name, or name=url for an origin other than https://name. A name equal
# to REROUTED_NAME is also the homeserver. Each needs DNS pointing here, and a certificate.
# REROUTED_COMMUNITIES=games.chat.example,art.chat.example
# The code POST create needs (at least 10 characters), or REROUTED_COMMUNITY_OPEN=on to let
# anyone who signs in create the community on a name that has none yet.
# REROUTED_COMMUNITY_CODE=
# REROUTED_COMMUNITY_OPEN=off
# Files in channels: days kept (0 keeps them until deleted) and bytes per community.
# REROUTED_COMMUNITY_FILE_DAYS=30
# REROUTED_COMMUNITY_FILE_QUOTA=10G
# History segments: bytes per community.
# REROUTED_COMMUNITY_HISTORY_QUOTA=10G
# Voice channels: one UDP port for every connection (0: a random port each), and the
# addresses to advertise behind 1:1 NAT.
# REROUTED_VOICE_UDP_PORT=0
# REROUTED_VOICE_PUBLIC_IPS=

# Dev mode only: federate with local servers over plain http.
# REROUTED_DEV=on
# REROUTED_DEV_PEERS=a.test=http://127.0.0.1:18091,b.test=http://127.0.0.1:18092
# REROUTED_PUBLIC_URL=http://127.0.0.1:18091

# On-demand TLS (deployment helper): other hostnames on this domain that may get
# certificates, such as a static site under the handle wildcard. Comma-separated.
# REROUTED_TLS_ASK_ALLOW=www.chat.example
# Other rerouted instances on this host to ask too, when the reverse proxy asks only one.
# REROUTED_TLS_ASK_ALSO=http://127.0.0.1:8081
